# =============================================================================
# Sylla Voyage - Dockerfile API (Node.js / Express / TypeScript)
# =============================================================================

# Étape 1 : Build TypeScript
FROM node:22-alpine AS builder

WORKDIR /app

# Copie des manifestes de dépendances
COPY apps/api/package*.json ./
RUN npm ci --ignore-scripts

# Copie des configurations et du code source
COPY apps/api/tsconfig.json ./
COPY apps/api/prisma.config.ts ./
COPY apps/api/prisma ./prisma
COPY apps/api/migrations ./migrations
COPY apps/api/src ./src

# Compilation TypeScript vers dist/
RUN npm run build

# Élagage des dépendances de développement pour préparer le runtime
RUN npm prune --omit=dev

# Étape 2 : Image d'exécution de production
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copie des dépendances prunées et des artefacts compilés
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/prisma.config.ts ./
COPY apps/api/package.json ./package.json

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "dist/server.js"]
