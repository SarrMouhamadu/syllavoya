# =============================================================================
# Sylla Voyage — Configuration d'environnement Docker (.env.example)
#
# Copier ce fichier en `.env` à la racine :
#   cp .env.example .env
#
# Ne jamais commiter `.env` réel dans Git.
# =============================================================================

# --- PostgreSQL (Réseau Docker interne uniquement, aucun port exposé) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_change_in_production
POSTGRES_DB=sylla_voyage_dev

# --- API Backend ---
NODE_ENV=production
API_PORT=3000
FRONTEND_URL=https://syllavoyage.com
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# --- Webhooks & Paiements (laisser les clés vides en local/dev) ---
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=your_naboopay_webhook_secret_here
NABOOPAY_BASE_URL=https://api.naboopay.com

# --- Frontend Web ---
WEB_PORT=5173
VITE_API_URL=https://api.syllavoyage.com/api

